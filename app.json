{
  "expo": {
    "name": "Rites",
    "slug": "rites-pilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.behnanozturkmen.ritespilot",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F5F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.behnanozturkmen.ritespilot"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F3F5F7"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "Sesli not kaydetmek için mikrofonu kullanır."
        }
      ],
      "expo-asset",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kartlarına fotoğraf eklemek için fotoğraflarını açar.",
          "cameraPermission": "Kartına ya da gelişim fotoğrafına fotoğraf çekmek için kamerayı kullanır.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Kişilerim'e eklemek için rehberinden bir kişi seçmeni sağlar. Rehberin Rites'a yüklenmez."
        }
      ]
    ],
    "scheme": "rites",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
